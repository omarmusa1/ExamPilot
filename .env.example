# Copy this file to .env and fill in the values.
# Optional: a shared Groq key (free at https://console.groq.com/keys). Users can also add their own key in Settings.
# Without any key the app runs in DEMO MODE (offline rule-based question generator).
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
SECRET_KEY=change-me-to-a-random-string
